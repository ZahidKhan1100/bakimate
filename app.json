{
  "expo": {
    "name": "BakiMate",
    "owner": "izahidkhan",
    "slug": "bakimate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "bakimate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihabimate.bakimate",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSContactsUsageDescription": "BakiMate suggests names and phone numbers from your contacts when you add a customer or supplier.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00875A",
        "foregroundImage": "./assets/images/icon.jpg"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ihabimate.bakimate"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#00875A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "BakiMate suggests names and phone numbers from your contacts when you add a customer or supplier."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BakiMate needs photo access so you can upload your DuitNow QR.",
          "cameraPermission": "BakiMate can use the camera if you capture your DuitNow QR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:8000/api",
      "websiteUrl": "https://bakimate.com",
      "revenueCatIos": "",
      "revenueCatAndroid": "",
      "revenueCatPremiumEntitlementId": "BakiMate Pro",
      "revenueCatOfferingId": "bakimate_pro",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleWebClientId": "",
      "googleExpoClientId": "",
      "router": {},
      "eas": {
        "projectId": "9a6aa5b0-c89b-4030-99fc-5c0e8d51aa06"
      }
    }
  }
}
