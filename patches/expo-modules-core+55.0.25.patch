+/**
+ * Finds the Android library software component Gradle wires for maven-publish.
+ * AGP usually registers `"release"` from `singleVariant("release")`, but IDE/tooling-only
+ * configuration runs can happen before components exist unless we defer publication wiring.
+ */
+private fun Project.findMavenSoftwareComponentPreferringRelease(): SoftwareComponent? {
+  components.findByName("release")?.let { return it }
+
+  return components.asMap.entries
+    .filter { entry ->
+      val name = entry.key
+      name.endsWith("Release", ignoreCase = true) &&
+        !name.endsWith("Debug", ignoreCase = true)
+    }
+    .minByOrNull { it.key.length }
+    ?.value
