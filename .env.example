# Production Laravel API (subdomain).
EXPO_PUBLIC_API_URL=https://api.bakimate.com/api

# Public marketing site (privacy, terms, delete-account instructions).
EXPO_PUBLIC_WEBSITE_URL=https://bakimate.com

# Local Laravel API (default iOS Simulator + same machine).
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Android emulator (AVD): host machine is 10.0.2.2, not 127.0.0.1.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Physical device on LAN: use your computer's IP and run `php artisan serve --host=0.0.0.0`.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Google Sign-In (OAuth client IDs from Google Cloud Console)
# iOS: OAuth client type "iOS" (bundle ID com.ihabimate.bakimate)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: OAuth client type "Android" (package + SHA-1 from your keystore / EAS credentials)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web: OAuth client IDs from Google Cloud Console — Expo uses this for token audience / redirect whitelist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Authorized redirect URIs (same Web OAuth client):
# - Expo Go: https://auth.expo.io/@YOUR_EXPO_OWNER/bakimate (see app.json owner + slug)
# - Native/production: Google rejects custom schemes (bakimate://). Deploy bakimate-backend and add this https URL:

EXPO_PUBLIC_GOOGLE_OAUTH_HTTPS_REDIRECT=

# Example (prod): EXPO_PUBLIC_GOOGLE_OAUTH_HTTPS_REDIRECT=https://api.bakimate.com/auth/google/expo-bridge

# Optional: same as Web client when using Expo Go / auth.expo.io (HabiMate-style). Leave empty to reuse WEB value in code.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# RevenueCat (native paywall) — public SDK keys from RevenueCat → Project settings → API keys.
# Copy this file to `.env` and fill values there (gitignored), or set the same names in EAS → Environment variables for cloud builds.
# Do not put real keys in `.env.example` — it is usually committed to git.
# iOS requires the Apple/App Store key (prefix appl_…); Android requires the Play key (goog_…).
# If offerings fail with HTTP 404, the key doesn’t match the project/app, bundle ID mismatches RevenueCat,
# or there is no default Offering — not a react-native-purchases bug.
# iOS: Apple app / Test Store key for bundle com.ihabimate.bakimate
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Android: Google Play package com.ihabimate.bakimate — key is NOT generated locally; RevenueCat assigns it once the app exists:
#   RevenueCat Dashboard → your project → Project settings → API keys → pick the Android (Google Play) app → copy “Public SDK key” (goog_…).
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Google Play subscription validation uses a Google Cloud SERVICE ACCOUNT JSON uploaded in RevenueCat (not Expo env):
# RevenueCat Dashboard → Projects → YOUR Android app → App settings → Service account credentials JSON.
# Create the key in Google Cloud Console, grant Play Console API access per RevenueCat docs, download the JSON ONCE — never commit it to git.

# Changed value requires a rebuild so `extra` updates.
EXPO_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT_ID=
# Optional — which Offering’s packages appear on the paywall — use RevenueCat Offerings UI **identifier** (e.g. bakimate_pro),
# matching keys in offerings.all — NOT RevenueCat internal ids starting with `ofrng` (those never appear as offering keys).
# If unset, the SDK uses RevenueCat’s "current" offering (often named "default"); set this if your real products live elsewhere.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# iOS: use App Store Sandbox (real receipts → RevenueCat) instead of Xcode’s `.storekit` scheme.
# Set to 1 before `npx expo prebuild` so the Xcode scheme does not attach `BakiMate.storekit`.
# Omit or leave unset to keep local StoreKit testing wired (Xcode `[Environment: Xcode]`).
# BAKIMATE_SKIP_STOREKIT_SCHEME=1
# Alternative: set revenueCatIos / revenueCatAndroid under expo.extra in app.json (not recommended for secrets).