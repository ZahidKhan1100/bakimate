# Production Laravel API on Railway (custom domain).
EXPO_PUBLIC_API_URL=https://bakimate.habimate.com/api

# Local Laravel API (default iOS Simulator + same machine).
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Android emulator (AVD): host machine is 10.0.2.2, not 127.0.0.1.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Physical device on LAN: use your computer's IP and run `php artisan serve --host=0.0.0.0`.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Google Sign-In (OAuth client IDs from Google Cloud Console)
# iOS: OAuth client type "iOS" (bundle ID com.ihabimate.bakimate)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: OAuth client type "Android" (package + SHA-1 from your keystore / EAS credentials)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web: token audience, Expo AuthSession, Expo Go proxy (authorized redirect URIs must include auth.expo.io URL)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: same as Web client when using Expo Go / auth.expo.io (HabiMate-style). Leave empty to reuse WEB value in code.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# RevenueCat (native paywall) — public SDK keys from RevenueCat → Project settings → API keys.
# iOS requires the Apple/App Store key (prefix appl_…); Android requires the Play key (goog_…).
# If offerings fail with HTTP 404, the key doesn’t match the project/app, bundle ID mismatches RevenueCat,
# or there is no default Offering — not a react-native-purchases bug.
# iOS: Apple app / Test Store key for bundle com.ihabimate.bakimate
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Android: Google Play package com.ihabimate.bakimate
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Entitlement identifier from RevenueCat → Product catalog → Entitlements (exact string; this project uses “BakiMate Pro”).
EXPO_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT_ID=
# Optional — which Offering’s packages appear on the paywall (exact identifier from RevenueCat → Offerings).
# If unset, the SDK uses RevenueCat’s "current" offering (often named "default"); set this if your real products live elsewhere.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
#
# Alternative: set revenueCatIos / revenueCatAndroid under expo.extra in app.json (not recommended for secrets).

